# -----------------------------------------------
# Git / version control
# -----------------------------------------------
.git
.gitignore
.hg
.svn

# -----------------------------------------------
# Go-specific files
# -----------------------------------------------
# Test binaries
*.test
# Test sources
*_test.go

# -----------------------------------------------
# IDE / OS settings and temporary files
# -----------------------------------------------
# IntelliJ IDEA settings
.idea/
# VS Code settings
.vscode/
# Claude Code local settings
.claude/
# IntelliJ IDEA project files
*.iml
# macOS metadata
.DS_Store
# Windows metadata
Thumbs.db

# -----------------------------------------------
# Documentation / settings files
# -----------------------------------------------
docs/
# README.md
README.md
# License file
LICENSE
# Cloud Run Job settings YAML (needed for deployment, not for the image build)
job-config*.yaml
# Cloud Build settings (not needed in the build context)
cloudbuild.yaml

# -----------------------------------------------
# Operations scripts (not needed for the image build)
# -----------------------------------------------
scripts/

# -----------------------------------------------
# Secrets (most important)
# -----------------------------------------------
# Files holding local environment variables or secrets
.env
.env.*
!.env.example
!.env.sample
# SSH keys and other private key files
*.key

# -----------------------------------------------
# Go build output and coverage (kept in sync with .gitignore)
# -----------------------------------------------
*.exe
*.dll
*.so
*.o
*.a
/bin/
/.gocache/
/.cache/
/coverage.out
/coverage.html
