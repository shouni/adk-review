# -----------------------------------------------
# Git/バージョン管理システム
# -----------------------------------------------
.git
.gitignore
.hg
.svn

# -----------------------------------------------
# Go言語特有のファイル
# -----------------------------------------------
# テスト実行用のバイナリ
*.test
# テストソースコード
*_test.go

# -----------------------------------------------
# IDE/OS の設定ファイルと一時ファイル
# -----------------------------------------------
# IntelliJ IDEA の設定
.idea/
# VS Code の設定
.vscode/
# Claude Code のローカル設定
.claude/
# IntelliJ IDEA のプロジェクトファイル
*.iml
# macOS のメタデータ
.DS_Store
# Windows のメタデータ
Thumbs.db

# -----------------------------------------------
# ドキュメント/設定ファイル
# -----------------------------------------------
docs/
# README.md
README.md
# ライセンスファイル
LICENSE
# Cloud Run Job の設定 YAML (設定自体はデプロイに必要だが、イメージビルドには不要)
job-config*.yaml
# Cloud Build 設定 (ビルドコンテキストには不要)
cloudbuild.yaml

# -----------------------------------------------
# 運用スクリプト (イメージビルドには不要)
# -----------------------------------------------
scripts/

# -----------------------------------------------
# 機密情報 (最重要)
# -----------------------------------------------
# ローカル環境変数や機密情報を含むファイル
.env
.env.*
!.env.example
!.env.sample
# SSHキーファイル、その他の秘密鍵ファイル
*.key

# -----------------------------------------------
# Go のビルド成果物・カバレッジ (.gitignore と同期)
# -----------------------------------------------
*.exe
*.dll
*.so
*.o
*.a
/bin/
/.gocache/
/.cache/
/coverage.out
/coverage.html
